{
  "name": "x-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "lint": "eslint *.ts **/*.ts **/*.tsx && yarn type-check",
    "lint:fix": "eslint --fix *.ts **/*.ts **/*.tsx",
    "icons:generate": "rimraf \"./icons\" && svgr --config-file svgr-icons.config.js -d src/icons assets/icons --ignore-existing",
    "storybook": "yarn icons:generate && storybook dev -p 6006",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@tanstack/react-form": "^1.3.0",
    "@tanstack/react-query": "^5.66.11",
    "axios": "^1.8.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "next": "15.2.1",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^3.26.1",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-animate-height": "^3.2.3",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-tooltip": "^5.28.0",
    "storybook": "^8.4.7",
    "tailwind-merge": "^3.0.2",
    "use-sync-external-store": "^1.4.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@svgr/cli": "^6.5.1",
    "@tanstack/eslint-plugin-query": "^5.62.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^8",
    "eslint-config-next": "15.2.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^0.11.1",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "postcss": "^8",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
